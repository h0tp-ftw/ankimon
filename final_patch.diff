+            try:
+                from ..singletons import notify_stats_changed
+                notify_stats_changed()
+            except Exception:
+                pass
+
+        except Exception as e:
+            return {"ok": False, "message": f"Sell failed: {e}"}
+
+        return {"ok": True, "message": f"Sold {ui_name} for {sell_price}¥"}
